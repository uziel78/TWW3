# Repo docs and tools: normalise to LF (bash needs LF in .sh and .sync files)
*.md   text eol=lf
*.sh   text eol=lf
*.py   text eol=lf
.sync  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Mod sources that go into packs: keep exact bytes, so a pack built from a checkout
# matches the one built from the masters
*.lua -text
*.xml -text
*.txt -text

# Game binaries: never diff or convert
*.pack binary
*.loc  binary
# DB table fragments have no extension (db/<table>/<fragment>)
**/db/**/* binary
